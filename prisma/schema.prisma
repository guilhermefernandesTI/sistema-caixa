datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
} 

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String        @id @default(cuid())
  tenantId        String        @default(cuid())
  username        String        @unique
  passwordHash    String
  displayName     String
  role            String        @default("client")
  businessName    String        @default("GF Venda Fácil")
  themePrimary    String        @default("#15231f")
  themeSecondary  String        @default("#d9f99d")
  themeAccent     String        @default("#42c98b")
  themeBackground String        @default("#f7f8f3")
  themeSidebar    String        @default("#15231f")
  themeText       String        @default("#17211d")
  themeCard       String        @default("#ffffff")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sessions        Session[]
  products        Product[]
  cashSessions    CashSession[]
  sales           Sale[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Product {
  id          String     @id @default(cuid())
  tenantId    String
  sku         String     @unique
  name        String
  category    String
  price       Decimal
  stock       Int        @default(0)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  ownerId     String?
  owner       User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  saleItems   SaleItem[]
}

model CashSession {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  openingAmount Decimal
  closingAmount Decimal?
  status        String    @default("OPEN")
  sales         Sale[]
}

model Sale {
  id            String         @id @default(cuid())
  tenantId      String
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  total         Decimal
  paymentMethod String
  cashSessionId String?
  cashSession   CashSession?   @relation(fields: [cashSessionId], references: [id])
  items         SaleItem[]
}

model SaleItem {
  id        String  @id @default(cuid())
  tenantId  String
  quantity  Int
  unitPrice Decimal
  saleId    String
  productId String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}
