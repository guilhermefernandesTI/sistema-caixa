datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  passwordHash    String
  displayName     String
  role            String    @default("client")
  businessName    String    @default("caixa flow")
  themePrimary    String    @default("#15231f")
  themeSecondary  String    @default("#d9f99d")
  themeAccent     String    @default("#42c98b")
  themeBackground String    @default("#f7f8f3")
  themeSidebar    String    @default("#15231f")
  themeText       String    @default("#17211d")
  themeCard       String    @default("#ffffff")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  category    String
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  saleItems   SaleItem[]
}

model CashSession {
  id            String    @id @default(cuid())
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  openingAmount Decimal   @db.Decimal(10, 2)
  closingAmount Decimal?  @db.Decimal(10, 2)
  status        String    @default("OPEN")
  sales         Sale[]
}

model Sale {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  total         Decimal        @db.Decimal(10, 2)
  paymentMethod String
  cashSessionId String?
  cashSession   CashSession?   @relation(fields: [cashSessionId], references: [id])
  items         SaleItem[]
}

model SaleItem {
  id        String  @id @default(cuid())
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  saleId    String
  productId String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}
